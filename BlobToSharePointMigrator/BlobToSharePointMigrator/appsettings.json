{
  "Migration": {
    "BlobConnectionString": "", // Azure Storage connection string (source inventory + blob reads for SPMI package).
    "SourceContainer": "your-container-name", // Blob container name to scan.
    "SharePointTenantId": "your-tenant-id-here", // Microsoft Entra tenant (directory) ID.
    "SharePointClientId": "your-app-registration-id-here", // App registration (client) ID for SharePoint access.
    "SharePointClientSecret": "", // Optional client secret (prefer certificate fields for unattended runs).
    "SharePointCertificatePath": "", // Path to PFX file for app-only certificate auth.
    "SharePointCertificatePassword": "", // PFX password when using SharePointCertificatePath.
    "SharePointCertificateThumbprint": "", // Cert thumbprint in store (alternative to PFX path).
    "SharePointSiteUrl": "https://yourtenant.sharepoint.com", // Target SharePoint site collection URL.
    "AdminUrl": "https://{tenantname}-admin.sharepoint.com", // SharePoint admin center (tenant name derived for logs).
    "SharePointCaseIdColumnDisplayName": "Wilerforce Case ID", // Library column display name resolved to internal field for CaseId.
    "SharePointCaseTypeColumnDisplayName": "Case Type", // Display name for Case Type column.
    "SharePointDocumentIdColumnDisplayName": "Document ID", // Display name for Document ID column.
    "BlobFolderPrefix": "", // Optional: only inventory blobs under this virtual folder prefix (empty = no prefix filter).
    "MigrationYear": 0, // Single-year filter on mapped path (0 = use range or no year filter per other rules).
    "MigrationYearStart": 0, // Inclusive start year when filtering by mapped path year (use with MigrationYearEnd).
    "MigrationYearEnd": 0, // Inclusive end year when filtering by mapped path year.
    "SharePointDocumentLibrary": "Documents", // Target library title when YearAsLibrary is false (exact site library name).
    "AllowedExtensions": [ ".pdf", ".csv", ".html", ".xml" ], // Extensions considered for migration (see inventory logic).
    "MappingFile": "mapping.json", // Path transform mapping file (copied next to the executable).
    "LogFile": "migration-log.txt", // Legacy/simple log filename if referenced elsewhere.
    "ReportFile": "migration-report.csv", // Per-file migration result CSV.
    "OverwriteAuditReportFile": "overwrite-audit.csv", // Batch/overwrite and metadata-eligibility audit CSV.
    "DeltaTrackingFile": "migrated-files.json", // Delta state for skipping unchanged files when DeltaMode is true.
    "DeltaMode": false, // When true, skip sources unchanged vs delta tracking (unless MetadataOnlyMode overrides).
    "ReportExistingFilesAsOverwritten": true, // Log SPMI 'already exists' as overwrite intent vs plain skip wording.
    "UploadParallelism": 8, // Parallelism hint for upload/package preparation paths.
    "MaxParallelJobs": 3, // Concurrent SPMI batch jobs; use 1 when debugging Save Conflict on one library.
    "MaxFilesPerJob": 50, // Maximum files per SPMI submission batch.
    "EnableMigrationJobSaveConflictRetry": false, // Auto-resubmit batch after Save Conflict (JobError) when under-processed.
    "MigrationJobSaveConflictRetries": 1, // Max resubmit attempts when EnableMigrationJobSaveConflictRetry is true.
    "MigrationJobSaveConflictRetryDelaySeconds": 45, // Delay between Save Conflict resubmit attempts.
    "TreatIncompleteSpmiBatchAsPartialSuccessForMetadata": false, // If SPMI FilesCreated < batch size (CompletedWithErrors), still mark PartialSuccess so STEP 5 can run (when safe).
    "PatchCaseTopFolderMetadataAfterFiles": true, // After patching files in STEP 5, set CaseId/CaseType on first folder under case (e.g. email folder).
    "MetadataOnlyMode": false, // Skip SPMI upload; only CSOM metadata patch on existing SharePoint paths, but it should be removed later
    "LogPerFileCaseProgress": true, // Verbose per-file staging logs (set false for huge jobs to shrink logs).
    "AssignDocumentIdFromCaseXml": true // Match case_*_documents.xml and set Metadata DocumentId when possible.
  },
  "SimpleETL": {
    "BatchSize": 6000,
    "EnableDetailedLogging": true,
    "MaxRecordsToProcess": 1000,
    "SingleProcessItems": true,
    "ProcessYear": "2023",
    "BulkProcessItems": false,
    "BulkProcessCombinedRevisions": false,
    "ProcessBoM": false,
    "ProcessTransactions": false,
    "ProcessLots": false,
    "CheckingOrg": false,
    "ProcessCategories": false,
    "ProcessSupplier": false,
    "ImportItemsToEBS": false,
    "BulkProcessManufacturereData": false,
    "BulkProcessManufacturerePartData": false,
    "BlobConnectionString": "",
    "ContainerName": "",
    "BlobFolderPrefix": "",

    "SHAREPOINT_TENANT_NAME": "",
    "SHAREPOINT_TENANT_ID": "",
    "SHAREPOINT_CLIENT_ID": "",
    "SHAREPOINT_CLIENT_SECRET": "",
    "SHAREPOINT_SITE_ID": "",
    "SHAREPOINT_SITE_URL": "",
    "SHAREPOINT_LIBRARY_NAME": "",
    "SHAREPOINT_TARGET_FOLDER": "",
    "SHAREPOINT_CASEID_COLUMN_DISPLAY_NAME": "Wilerforce Case ID",
    "SHAREPOINT_CASETYPE_COLUMN_DISPLAY_NAME": "Case Type",
    "SHAREPOINT_DOCUMENTID_COLUMN_DISPLAY_NAME": "Document ID",
    "UseYyyyCaseNumberPath": "Y",
    "GRAPH_API_SCOPE": "https://graph.microsoft.com/.default",
    "UseYearDrives": "true",
    "MIGRATION_YEAR": 2023,
    "SharePointSiteId": "",
    "DriveId": "",
    "SharePointLibraryName": "",
    "TargetFolderPath": "",
    "AdminUrl": "https://{tenantname}-admin.sharepoint.com"
  },
  "ConnectionStrings": {
    "SqlServerLocal": "",
    "SqlServerX": "",
    "OracleLocal": "",
    "OracleX": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/etl-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }

}
